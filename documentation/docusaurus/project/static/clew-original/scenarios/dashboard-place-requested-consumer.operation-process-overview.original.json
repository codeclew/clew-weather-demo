    "dashboard-021fcd0ff7baa53bd3c5": {
      "authority": "EXACT_SNAPSHOT_TEXT",
      "endLine": 29,
      "evidenceDigest": "sha256:22ebf7db7dae9a64302aa66ec1c954aa1cff1f8ccf16b91e12912486c38d8920",
      "file": "services/dashboard/src/events.ts",
      "id": "dashboard-021fcd0ff7baa53bd3c5",
      "occurrence": {
        "blob": "ddda5719da0d973028010984703f3ee5163090f5",
