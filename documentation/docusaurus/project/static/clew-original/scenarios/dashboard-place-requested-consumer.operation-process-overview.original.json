    "dashboard-a4627e5e868830287e83": {
      "authority": "EXACT_SNAPSHOT_TEXT",
      "endLine": 60,
      "evidenceDigest": "sha256:84807f84d849913304ca71c2c58452d15c4ab38ed5c4d432396fc7fdb4c3af13",
      "file": "services/dashboard/src/main.ts",
