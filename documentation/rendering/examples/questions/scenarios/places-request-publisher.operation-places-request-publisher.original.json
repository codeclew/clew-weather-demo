    "events": [
      {
        "dependencyIds": [
          "places:flow:158b244bf277169193530f80",
          "places:symbol:7fb8137cf82d592b243e54aa"
        ],
        "id": "claim-5e4fb5b4a179d1c43e2b",
        "kind": "loop",
        "sourceIds": [
          "places-158b244bf27716919353",
          "places-7fb8137cf82d592b243e"
        ],
        "text": "Repeat while the cancellation token is not signalled; each pass attempts one pending row, then waits one second."
      },
      {
        "dependencyIds": [
          "places:symbol:722b268c12cec9e1cb51cbe8"
        ],
        "from": "service-places",
        "id": "claim-5d184223c32ec68b480c",
        "kind": "message",
        "sourceIds": [
          "places-722b268c12cec9e1cb51"
        ],
        "text": "PublishPending opens a connection and transaction, then selects one eligible unpublished row in created_at order, limited to one and locked with SKIP LOCKED.",
        "to": "places-db"
      },
      {
        "dependencyIds": [
          "places:symbol:722b268c12cec9e1cb51cbe8"
        ],
        "id": "claim-d1bb4d8b8ebbde14e869",
        "kind": "alt",
        "sourceIds": [
          "places-722b268c12cec9e1cb51"
        ],
        "text": "If the select returns no row, PublishPending returns for this pass; otherwise it sends the selected payload and records the completed send."
      },
      {
        "dependencyIds": [
          "places:symbol:722b268c12cec9e1cb51cbe8"
        ],
        "id": "claim-6e445dad38c309bfb434",
        "kind": "note",
        "sourceIds": [
          "places-722b268c12cec9e1cb51"
        ],
        "text": "No row is sent when the reader is empty; the using scopes dispose the open transaction and connection on return."
      },
      {
        "dependencyIds": [
          "places:symbol:722b268c12cec9e1cb51cbe8"
        ],
        "id": "claim-84d4e111ed85e5a6774f",
        "kind": "else",
        "sourceIds": [
          "places-722b268c12cec9e1cb51"
        ],
        "text": "Otherwise"
      },
      {
        "dependencyIds": [
          "places:symbol:722b268c12cec9e1cb51cbe8"
        ],
        "from": "service-places",
        "id": "claim-02699e133726492dbc5b",
        "kind": "message",
        "sourceIds": [
          "places-722b268c12cec9e1cb51"
        ],
        "text": "Extract place.id from the stored payload and await ProduceAsync to weather.place-requested with place.id as the message key and the original payload as the value.",
        "to": "places-kafka"
      },
      {
        "dependencyIds": [
          "places:symbol:722b268c12cec9e1cb51cbe8"
        ],
        "from": "service-places",
        "id": "claim-e18eff8054f84ba9972c",
        "kind": "message",
        "sourceIds": [
          "places-722b268c12cec9e1cb51"
        ],
        "text": "After ProduceAsync completes, update that outbox row to published=true and commit the database transaction.",
        "to": "places-db"
      },
      {
        "dependencyIds": [
          "places:symbol:722b268c12cec9e1cb51cbe8",
          "places:symbol:7fb8137cf82d592b243e54aa"
        ],
        "id": "claim-f5798d4b4a45388d70ad",
        "kind": "note",
        "sourceIds": [
          "places-722b268c12cec9e1cb51",
          "places-7fb8137cf82d592b243e"
        ],
        "text": "A crash after the broker send but before the database commit can leave the row unpublished for a later send; producer idempotence does not make Kafka and PostgreSQL one atomic transaction."
      },
      {
        "dependencyIds": [
          "places:symbol:722b268c12cec9e1cb51cbe8"
        ],
        "id": "claim-dce06a22daeb4942f9b6",
        "kind": "end",
        "sourceIds": [
          "places-722b268c12cec9e1cb51"
        ],
        "text": ""
      },
      {
        "dependencyIds": [
          "places:flow:096b7f6a391d982235e434ce",
          "places:symbol:7fb8137cf82d592b243e54aa"
        ],
        "id": "claim-a1da6f698c2bdfdf8068",
        "kind": "alt",
        "sourceIds": [
          "places-096b7f6a391d982235e4",
          "places-7fb8137cf82d592b243e"
        ],
        "text": "If PublishPending throws OperationCanceledException while the token is cancelled, the loop exits; other errors are handled by the general catch."
      },
      {
        "dependencyIds": [
          "places:symbol:7fb8137cf82d592b243e54aa"
        ],
        "id": "claim-36f270f7d835dff9dcca",
        "kind": "note",
        "sourceIds": [
          "places-7fb8137cf82d592b243e"
        ],
        "text": "An OperationCanceledException observed while the token is cancelled breaks the loop."
      },
      {
        "dependencyIds": [
          "places:flow:096b7f6a391d982235e434ce",
          "places:symbol:7fb8137cf82d592b243e54aa"
        ],
        "id": "claim-ed716f0ae11456c59aac",
        "kind": "else",
        "sourceIds": [
          "places-096b7f6a391d982235e4",
          "places-7fb8137cf82d592b243e"
        ],
        "text": "Otherwise"
      },
      {
        "dependencyIds": [
          "places:symbol:7fb8137cf82d592b243e54aa"
        ],
        "id": "claim-7f09695286f324c4f3f1",
        "kind": "note",
        "sourceIds": [
          "places-7fb8137cf82d592b243e"
        ],
        "text": "Other exceptions are logged with PUBLISH_RETRY; normal completion and logged failures continue to the one-second delay. The delay also receives the token, so cancellation reaching that await can propagate."
      },
      {
        "dependencyIds": [
          "places:flow:096b7f6a391d982235e434ce",
