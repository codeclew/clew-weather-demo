        {
          "id": "confidence",
          "title": "Full description and sources",
          "navTitle": "Sources and provenance",
          "blocks": [
            {
              "title": "Object context",
              "text": "Place contains Id, Name, Latitude and Longitude. SavePlace carries CityId; request_outbox holds a delivery record. Formal domain identity and ownership have not been declared in the saved evidence.",
              "evidence": [
                {
                  "kind": "RETAINED",
                  "subject": "service:places",
                  "operation": "section-entities",
                  "fragmentId": "claim-b4df91eec926f5311ba3",
                  "textDigest": "sha256:210a03ea2fae06e4339930e231217be787d2ee38eb30cb299e23c90ed36ee27e"
                }
              ]
            },
            {
              "title": "Story boundary",
              "text": "An outbox record alone does not prove Kafka publication, delivery, processing or a forecast ready to display. Related accounts retain their own sources and limits; their links do not establish an observed execution sequence.",
              "evidence": [
                {
                  "kind": "RETAINED",
                  "subject": "scenario:dashboard-save-city",
                  "operation": "dashboard-save-city",
                  "fragmentId": "claim-1cd536e010d3cd375a7e",
