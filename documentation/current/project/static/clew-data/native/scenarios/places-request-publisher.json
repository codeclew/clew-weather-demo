      "purpose": "Places publishes saved outbox requests and records completed sends.",
      "schema": "codeclew-question-reading-plan/1.0",
      "sections": [
        {
          "blocks": [
            {
              "authority": "EDITORIAL_READING_GUIDE_NOT_ACCEPTED_PROSE",
              "disclosure": null,
              "evidence": [
                {
                  "fragment": {
                    "dependencyIds": [
                      "places:symbol:722b268c12cec9e1cb51cbe8"
                    ],
                    "from": "service-places",
                    "id": "claim-5d184223c32ec68b480c",
                    "kind": "message",
                    "sourceIds": [
                      "places-722b268c12cec9e1cb51"
                    ],
                    "text": "PublishPending opens a connection and transaction, then selects one eligible unpublished row in created_at order, limited to one and locked with SKIP LOCKED.",
                    "to": "places-db"
                  },
                  "kind": "RETAINED_CLAIM",
                  "operation": "places-request-publisher",
                  "sourceContext": {
                    "$clewRef": "sha256:532c0cbde5ec5e323ccbcfcaa71f0009389b9d8d7e46005486ecccf091a92ca2"
                  },
                  "sources": {
                    "$clewRef": "sha256:d06fc6143b37de355d3a64ebfa37beb447aad9a6c7ae80280250b3b62e0606dd"
                  },
                  "state": {
                    "$clewRef": "sha256:80a3d471b0896596761520253625c1508954ad0b77b4e8b9ee9668df32f91fc8"
                  },
                  "subject": "scenario:places-request-publisher",
                  "title": "Place request publisher"
                },
                {
                  "fragment": {
                    "dependencyIds": [
                      "places:symbol:722b268c12cec9e1cb51cbe8"
                    ],
                    "id": "claim-6e445dad38c309bfb434",
                    "kind": "note",
                    "sourceIds": [
                      "places-722b268c12cec9e1cb51"
                    ],
                    "text": "No row is sent when the reader is empty; the using scopes dispose the open transaction and connection on return."
                  },
                  "kind": "RETAINED_CLAIM",
                  "operation": "places-request-publisher",
                  "sourceContext": {
                    "$clewRef": "sha256:532c0cbde5ec5e323ccbcfcaa71f0009389b9d8d7e46005486ecccf091a92ca2"
                  },
                  "sources": {
                    "$clewRef": "sha256:d06fc6143b37de355d3a64ebfa37beb447aad9a6c7ae80280250b3b62e0606dd"
                  },
                  "state": {
                    "$clewRef": "sha256:80a3d471b0896596761520253625c1508954ad0b77b4e8b9ee9668df32f91fc8"
                  },
                  "subject": "scenario:places-request-publisher",
                  "title": "Place request publisher"
                }
              ],
              "id": null,
              "links": [],
              "navTitle": null,
              "preview": null,
              "text": "The publishing loop attempts one eligible unpublished request at a time. If no row is selected, this pass sends nothing.",
              "title": "Find work",
              "tone": null
            },
            {
              "authority": "EDITORIAL_READING_GUIDE_NOT_ACCEPTED_PROSE",
              "disclosure": "Selection and producer settings",
              "evidence": {
                "$clewRef": "sha256:4d8be77413c045636379e8f630113b588c70e62d2b9313e27ed28357a83c030a"
              },
              "id": null,
              "links": [],
              "navTitle": null,
              "preview": "One eligible row · created_at order · selected-source configuration",
              "text": "The query orders by created_at, selects at most one row and uses FOR UPDATE SKIP LOCKED. The producer uses KAFKA_BOOTSTRAP or kafka:9092, enables idempotence and configures a 10-second message timeout. Runtime hosting activation is not established.",
              "title": "Selection and producer settings",
              "tone": null
            }
          ],
          "icon": "database",
          "id": "pending",
          "navTitle": "Pending work",
          "number": 1,
          "route": null,
          "title": "Places looks for a pending request"
        },
        {
          "blocks": [
            {
              "authority": "EDITORIAL_READING_GUIDE_NOT_ACCEPTED_PROSE",
              "disclosure": null,
              "evidence": [
                {
                  "fragment": {
                    "dependencyIds": [
                      "places:symbol:722b268c12cec9e1cb51cbe8"
                    ],
                    "from": "service-places",
                    "id": "claim-02699e133726492dbc5b",
                    "kind": "message",
                    "sourceIds": [
                      "places-722b268c12cec9e1cb51"
                    ],
                    "text": "Extract place.id from the stored payload and await ProduceAsync to weather.place-requested with place.id as the message key and the original payload as the value.",
                    "to": "places-kafka"
                  },
                  "kind": "RETAINED_CLAIM",
                  "operation": "places-request-publisher",
                  "sourceContext": {
                    "$clewRef": "sha256:532c0cbde5ec5e323ccbcfcaa71f0009389b9d8d7e46005486ecccf091a92ca2"
                  },
                  "sources": {
                    "$clewRef": "sha256:d06fc6143b37de355d3a64ebfa37beb447aad9a6c7ae80280250b3b62e0606dd"
                  },
                  "state": {
                    "$clewRef": "sha256:80a3d471b0896596761520253625c1508954ad0b77b4e8b9ee9668df32f91fc8"
                  },
                  "subject": "scenario:places-request-publisher",
                  "title": "Place request publisher"
                }
              ],
              "id": null,
              "links": [],
              "navTitle": null,
              "preview": null,
              "text": "The selected payload is sent to `weather.place-requested`, using the place ID as its message key. The code awaits the send before changing the outbox row.",
              "title": "Publish",
              "tone": null
            },
            {
              "authority": "EDITORIAL_READING_GUIDE_NOT_ACCEPTED_PROSE",
              "disclosure": null,
              "evidence": [
                {
                  "$clewRef": "sha256:df4895dcab1a0531e78ea951dc8ce326582a06acbbf8e80fa41ab8c8c8018204"
                }
              ],
              "id": "publish-error",
              "links": [],
              "navTitle": "Publish failure",
              "preview": null,
              "text": "Other exceptions are logged as `PUBLISH_RETRY`. While the loop remains active, later passes can attempt pending work again.",
              "title": "If the attempt fails",
              "tone": "ERROR"
            }
          ],
          "icon": "arrow-right",
          "id": "send",
          "navTitle": "Send event",
          "number": 2,
          "route": "Topic: weather.place-requested",
          "title": "Places sends the stored event"
        },
        {
          "blocks": [
            {
              "authority": "EDITORIAL_READING_GUIDE_NOT_ACCEPTED_PROSE",
              "disclosure": null,
              "evidence": [
                {
                  "fragment": {
                    "dependencyIds": [
                      "places:symbol:722b268c12cec9e1cb51cbe8"
                    ],
                    "from": "service-places",
                    "id": "claim-e18eff8054f84ba9972c",
                    "kind": "message",
                    "sourceIds": [
                      "places-722b268c12cec9e1cb51"
                    ],
                    "text": "After ProduceAsync completes, update that outbox row to published=true and commit the database transaction.",
                    "to": "places-db"
                  },
                  "kind": "RETAINED_CLAIM",
                  "operation": "places-request-publisher",
                  "sourceContext": {
                    "$clewRef": "sha256:532c0cbde5ec5e323ccbcfcaa71f0009389b9d8d7e46005486ecccf091a92ca2"
                  },
                  "sources": {
                    "$clewRef": "sha256:d06fc6143b37de355d3a64ebfa37beb447aad9a6c7ae80280250b3b62e0606dd"
                  },
                  "state": {
                    "$clewRef": "sha256:80a3d471b0896596761520253625c1508954ad0b77b4e8b9ee9668df32f91fc8"
                  },
                  "subject": "scenario:places-request-publisher",
                  "title": "Place request publisher"
                }
              ],
              "id": null,
              "links": [
                {
                  "href": "../services/places.html#section-entities",
                  "label": "Place · fields and context",
                  "operation": "section-entities",
                  "subject": "service:places"
                }
              ],
              "navTitle": null,
              "preview": null,
              "text": "After the send completes, the outbox row is marked published and the database transaction is committed.",
              "title": "Record outcome",
              "tone": null
            },
            {
              "authority": "EDITORIAL_READING_GUIDE_NOT_ACCEPTED_PROSE",
              "disclosure": null,
              "evidence": [
                {
                  "fragment": {
                    "dependencyIds": [
                      "places:symbol:722b268c12cec9e1cb51cbe8",
                      "places:symbol:7fb8137cf82d592b243e54aa"
                    ],
                    "id": "claim-f5798d4b4a45388d70ad",
                    "kind": "note",
                    "sourceIds": [
                      "places-722b268c12cec9e1cb51",
                      "places-7fb8137cf82d592b243e"
                    ],
                    "text": "A crash after the broker send but before the database commit can leave the row unpublished for a later send; producer idempotence does not make Kafka and PostgreSQL one atomic transaction."
                  },
                  "kind": "RETAINED_CLAIM",
                  "operation": "places-request-publisher",
                  "sourceContext": {
                    "$clewRef": "sha256:532c0cbde5ec5e323ccbcfcaa71f0009389b9d8d7e46005486ecccf091a92ca2"
                  },
                  "sources": {
                    "$clewRef": "sha256:7df30dda668a40807bbb0da3ee43374a41a1458e76c0227a21a1a0e06b59a40b"
                  },
                  "state": {
                    "$clewRef": "sha256:80a3d471b0896596761520253625c1508954ad0b77b4e8b9ee9668df32f91fc8"
                  },
                  "subject": "scenario:places-request-publisher",
                  "title": "Place request publisher"
                }
              ],
              "id": "replay-window",
              "links": [],
              "navTitle": "Send-before-commit window",
              "preview": null,
              "text": "A completed broker send followed by a crash or database-commit failure can leave the row pending. It may be sent again; producer idempotence does not make Kafka and the database one atomic transaction.",
              "title": "If the process stops between send and commit",
              "tone": "WARNING"
            }
          ],
          "icon": "database",
          "id": "record",
          "navTitle": "Record send",
          "number": 3,
          "route": null,
          "title": "Places marks the request as published"
        },
        {
          "blocks": [
            {
              "authority": "EDITORIAL_READING_GUIDE_NOT_ACCEPTED_PROSE",
              "disclosure": null,
              "evidence": [
                {
                  "fragment": {
                    "dependencyIds": [
                      "places:flow:158b244bf277169193530f80",
                      "places:symbol:7fb8137cf82d592b243e54aa"
                    ],
                    "id": "claim-5e4fb5b4a179d1c43e2b",
                    "kind": "loop",
                    "sourceIds": [
                      "places-158b244bf27716919353",
                      "places-7fb8137cf82d592b243e"
                    ],
                    "text": "Repeat while the cancellation token is not signalled; each pass attempts one pending row, then waits one second."
                  },
                  "kind": "RETAINED_CLAIM",
                  "operation": "places-request-publisher",
                  "sourceContext": {
                    "$clewRef": "sha256:532c0cbde5ec5e323ccbcfcaa71f0009389b9d8d7e46005486ecccf091a92ca2"
                  },
                  "sources": {
                    "places-158b244bf27716919353": {
                      "$clewRef": "sha256:a0297a2ef05d2d41e7c12a344c24091c5b8976f8b4240b03ed9698d1adaf5298"
                    },
                    "places-7fb8137cf82d592b243e": {
                      "$clewRef": "sha256:b970c6d235f9c5eb2f4e16bc78eda2a4ee3a68751103a8811054e9802c535d97"
                    }
                  },
                  "state": {
                    "$clewRef": "sha256:80a3d471b0896596761520253625c1508954ad0b77b4e8b9ee9668df32f91fc8"
                  },
                  "subject": "scenario:places-request-publisher",
                  "title": "Place request publisher"
                },
                {
                  "$clewRef": "sha256:df4895dcab1a0531e78ea951dc8ce326582a06acbbf8e80fa41ab8c8c8018204"
                }
              ],
              "id": null,
              "links": [],
              "navTitle": null,
              "preview": null,
              "text": "Normal completion and logged failures are followed by a one-second wait. Each pass attempts one pending row.",
              "title": "Next attempt",
              "tone": null
            },
            {
              "authority": "EDITORIAL_READING_GUIDE_NOT_ACCEPTED_PROSE",
              "disclosure": "Cancellation details",
              "evidence": [
                {
                  "fragment": {
                    "dependencyIds": [
                      "places:symbol:7fb8137cf82d592b243e54aa"
                    ],
                    "id": "claim-36f270f7d835dff9dcca",
                    "kind": "note",
                    "sourceIds": [
                      "places-7fb8137cf82d592b243e"
                    ],
                    "text": "An OperationCanceledException observed while the token is cancelled breaks the loop."
                  },
                  "kind": "RETAINED_CLAIM",
                  "operation": "places-request-publisher",
                  "sourceContext": {
                    "$clewRef": "sha256:532c0cbde5ec5e323ccbcfcaa71f0009389b9d8d7e46005486ecccf091a92ca2"
                  },
                  "sources": {
                    "$clewRef": "sha256:ff0da895393c9f0dfecd0e6ea8aabd314b3a671596dea38a957a76fb796b5571"
                  },
                  "state": {
                    "$clewRef": "sha256:80a3d471b0896596761520253625c1508954ad0b77b4e8b9ee9668df32f91fc8"
                  },
                  "subject": "scenario:places-request-publisher",
                  "title": "Place request publisher"
                },
                {
                  "$clewRef": "sha256:df4895dcab1a0531e78ea951dc8ce326582a06acbbf8e80fa41ab8c8c8018204"
                }
              ],
              "id": null,
              "links": [],
              "navTitle": null,
              "preview": "Publish-attempt cancellation and delay cancellation take different paths",
              "text": "Cancellation observed during the publish attempt exits the loop. Cancellation reaching the following delay can propagate from that await.",
              "title": "Cancellation",
              "tone": null
            }
          ],
          "icon": null,
          "id": "continue",
          "navTitle": "Continue or stop",
          "number": 4,
          "route": null,
          "title": "The loop continues or stops"
        },
