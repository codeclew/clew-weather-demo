      "service": "dashboard",
      "startLine": 76,
      "text": "async function requestRefresh(request: FastifyRequest<{ Params: { id: string } }>, reply: FastifyReply): Promise<void> {\n  try {\n    const response = await fetch(`${placesUrl}/places/${encodeURIComponent(request.params.id)}/refresh`, { method: 'POST', signal: AbortSignal.timeout(10000) })\n    reply.code(response.status).send(await response.json())\n  } catch {\n    reply.code(503).send({ error: 'PLACES_UNAVAILABLE' })\n  }\n}",
      "textDigest": "sha256:8a1197a24ccae2bc108ed3180894b777ff122a2be4b0f3510f70588e0e3d8dbf",
      "url": "https://github.com/codeclew/clew-weather-demo/blob/e635069293d58cb0d4f28c8211e748b8d58e6b37/services/dashboard/src/main.ts#L76-L83"
    },
    "places-24afabf4ce6fb0dad4a7": {
      "authority": "EXACT_SNAPSHOT_TEXT",
      "endLine": 35,
      "evidenceDigest": "sha256:487584dbc384e0e338e2012a06945189bb9ec2319685c5372d7d46398361d779",
      "file": "services/places/PlacesRepository.cs",
      "id": "places-24afabf4ce6fb0dad4a7",
      "revision": "c289b28be4819eddf29d59a7c12f178559ec5229",
      "service": "places",
      "startLine": 35,
      "text": "public async Task<Place?> Find(string id, CancellationToken token) => (await List(token)).FirstOrDefault(place => place.Id == id);",
      "textDigest": "sha256:f692ab2520e99ad47d33ab10b9fb7635632605a44e9fe9fb71430be31e67dc1d",
      "url": "https://github.com/codeclew/clew-weather-demo/blob/c289b28be4819eddf29d59a7c12f178559ec5229/services/places/PlacesRepository.cs#L35-L35"
    },
    "places-434ffab68fae2f991ebb": {
      "authority": "EXACT_SNAPSHOT_TEXT",
      "endLine": 51,
      "evidenceDigest": "sha256:a7d9b5f982ccab84663c4722fed07685128ee25272a231c6881ead24473d40b2",
      "file": "services/places/PlacesRepository.cs",
      "id": "places-434ffab68fae2f991ebb",
      "revision": "c289b28be4819eddf29d59a7c12f178559ec5229",
      "service": "places",
      "startLine": 45,
      "text": "public async Task Enqueue(Place city, CancellationToken token)\n    {\n        await using var connection = await Open(token);\n        await using var transaction = await connection.BeginTransactionAsync(token);\n        await InsertRequest(connection, transaction, city, token);\n        await transaction.CommitAsync(token);\n    }",
      "textDigest": "sha256:40ed706a263273c9e3bcb5f1333c4d2693b466f3572b750f00bcafbdc76eb5d6",
      "url": "https://github.com/codeclew/clew-weather-demo/blob/c289b28be4819eddf29d59a7c12f178559ec5229/services/places/PlacesRepository.cs#L45-L51"
    },
    "places-51d94b76d870001475fd": {
      "authority": "EXACT_SNAPSHOT_TEXT",
      "endLine": 59,
      "evidenceDigest": "sha256:b689dee06cb34ef50c8065d11fb20f73938f8871d06debf64b44ab39d3f606dc",
      "file": "services/places/PlacesRepository.cs",
      "id": "places-51d94b76d870001475fd",
      "revision": "c289b28be4819eddf29d59a7c12f178559ec5229",
      "service": "places",
      "startLine": 52,
      "text": "private static async Task InsertRequest(NpgsqlConnection connection, NpgsqlTransaction transaction, Place city, CancellationToken token)\n    {\n        var id = Guid.NewGuid();\n        var json = JsonSerializer.Serialize(new { id, type = \"place.requested\", version = 1, place = city }, new JsonSerializerOptions(JsonSerializerDefaults.Web));\n        await using var command = new NpgsqlCommand(\"INSERT INTO request_outbox(id,payload) VALUES($1,$2::jsonb)\", connection, transaction);\n        command.Parameters.AddWithValue(id); command.Parameters.AddWithValue(json);\n        await command.ExecuteNonQueryAsync(token);\n    }",
      "textDigest": "sha256:b760523f1391d08669d20d18510de700ebf367c42ddc23365d51e63bb03037c3",
      "url": "https://github.com/codeclew/clew-weather-demo/blob/c289b28be4819eddf29d59a7c12f178559ec5229/services/places/PlacesRepository.cs#L52-L59"
    },
    "places-65de4bdfa04d114b73df": {
      "authority": "EXACT_SNAPSHOT_TEXT",
      "endLine": 25,
      "evidenceDigest": "sha256:26c60cb63612bc6a088c1e7a6047c0097c5865a0f50a4e6c1be044e0b211ff93",
      "file": "services/places/PlacesController.cs",
      "id": "places-65de4bdfa04d114b73df",
      "revision": "c289b28be4819eddf29d59a7c12f178559ec5229",
      "service": "places",
      "startLine": 18,
      "text": "[HttpPost(\"/places/{id}/refresh\")]\n    public async Task<IActionResult> Refresh(string id, CancellationToken token)\n    {\n        var city = await repository.Find(id, token);\n        if (city is null) return NotFound(new { error = \"PLACE_NOT_FOUND\" });\n        await repository.Enqueue(city, token);\n        return Accepted(new { placeId = id, status = \"QUEUED\" });\n    }",
      "textDigest": "sha256:15621e3458e3e37377113dbf343bd3621c520edd48affea91206c49bec8b238f",
      "url": "https://github.com/codeclew/clew-weather-demo/blob/c289b28be4819eddf29d59a7c12f178559ec5229/services/places/PlacesController.cs#L18-L25"
    },
    "places-707eb762b8c1f4718a5b": {
      "authority": "EXACT_SNAPSHOT_TEXT",
      "endLine": 25,
      "evidenceDigest": "sha256:dd944e62ed29bc0de6b9010d3b98be1672082ccdb56a582c4993cf684a8e810d",
      "file": "services/places/PlacesRepository.cs",
      "id": "places-707eb762b8c1f4718a5b",
      "revision": "c289b28be4819eddf29d59a7c12f178559ec5229",
      "service": "places",
      "startLine": 20,
      "text": "public async Task<NpgsqlConnection> Open(CancellationToken token)\n    {\n        var connection = new NpgsqlConnection(connectionString);\n        try { await connection.OpenAsync(token); return connection; }\n        catch { await connection.DisposeAsync(); throw; }\n    }",
      "textDigest": "sha256:3027a4abb6d1fb5ef007a0d0783be38a6766fe294e0a1dfac9990b2c00975ce4",
      "url": "https://github.com/codeclew/clew-weather-demo/blob/c289b28be4819eddf29d59a7c12f178559ec5229/services/places/PlacesRepository.cs#L20-L25"
    }
