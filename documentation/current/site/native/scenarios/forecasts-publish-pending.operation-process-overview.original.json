      "file": "services/forecasts/src/main/kotlin/weather/Forecasts.kt",
      "id": "forecasts-3d7b217355f2e6a34064",
      "occurrence": {
        "blob": "7ed34fcd2d3540241148596c97a5d66fe5f2578a",
        "endByte": 9647,
