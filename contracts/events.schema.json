{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "place"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "place.requested"
        },
        "version": {
          "const": 1
        },
        "place": {
          "type": "object",
          "required": [
            "id",
            "name",
            "latitude",
            "longitude"
          ],
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "oslo",
                "helsinki",
                "lisbon"
              ]
            },
            "name": {
              "type": "string"
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "place",
        "forecast"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "forecast.updated"
        },
        "version": {
          "const": 1
        },
        "place": {
          "type": "object",
          "required": [
            "id",
            "name",
            "latitude",
            "longitude"
          ],
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "oslo",
                "helsinki",
                "lisbon"
              ]
            },
            "name": {
              "type": "string"
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "forecast": {
          "type": "object",
          "required": [
            "updatedAt",
            "fetchedAt",
            "mode",
            "periods"
          ],
          "properties": {
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "fetchedAt": {
              "type": "string",
              "format": "date-time"
            },
            "mode": {
              "type": "string",
              "enum": [
                "fixture",
                "live"
              ]
            },
            "periods": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "time",
                  "temperatureC",
                  "precipitationMm",
                  "symbol"
                ],
                "properties": {
                  "time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "temperatureC": {
                    "type": "number"
                  },
                  "precipitationMm": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "symbol": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
