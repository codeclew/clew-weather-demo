{
  "openapi": "3.1.0",
  "info": {
    "title": "forecasts",
    "version": "1.0.0"
  },
  "paths": {
    "/forecasts/{id}": {
      "get": {
        "operationId": "forecasts_get_forecasts_id",
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "updatedAt",
                    "fetchedAt",
                    "mode",
                    "periods"
                  ],
                  "properties": {
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "fetchedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "fixture",
                        "live"
                      ]
                    },
                    "periods": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 6,
                      "items": {
                        "type": "object",
                        "required": [
                          "time",
                          "temperatureC",
                          "precipitationMm",
                          "symbol"
                        ],
                        "properties": {
                          "time": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "temperatureC": {
                            "type": "number"
                          },
                          "precipitationMm": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "symbol": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "404"
          },
          "500": {
            "description": "500",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "oslo",
                "helsinki",
                "lisbon"
              ]
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "forecasts_get_health",
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "const": "READY"
                    },
                    "kafka": {
                      "const": "READY"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "500",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "forecasts_get_openapi.json",
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "500": {
            "description": "500",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
