T_SNAPSHOT_TEXT","endLine":68,"evidenceDigest":"sha256:057d94e839943f3839919eebe0ab40ec10f525063bd4a5ce28e734a09b4a27e0","file":"services/forecasts/src/main/kotlin/weather/Forecasts.kt","id":"forecasts-1ea53b95922ad5791d93","occurrence":{"blob":"7ed34fcd2d3540241148596c97a5d66fe5f2578a","endByte":4055,"snapshot":"sha256:34e943cd4cacb091768f46eaf8c99085c35c984784552ac335293714c4bd35b3","startByte":3389},"revision":"c289b28be4819eddf29d59a7c12f178559ec5229","service":"forecasts","startLine":62,"text":"@Scheduled(fixedDelayString = \"\\${REFRESH_INTERVAL_MS:60000}\")\n    fun refreshExpired() {\n        val places = jdbc.query(\"SELECT p.id,p.name,p.latitude,p.longitude FROM places p LEFT JOIN forecasts f ON f.place_id=p.id WHERE f.expires_at IS NULL OR f.expires_at<now() ORDER BY p.id\", { row, _ -> json.createObjectNode().put(\"id\", row.getString(1)).put(\"name\", row.getString(2)).put(\"latitude\", row.getDouble(3)).put(\"longitude\", row.getDouble(4)) })\n        for (place in places) {\n            try { transaction.executeWithoutResult { refresh(place) } } catch (error: Exception) { System.err.println(\"FORECAST_RETRY:\" + error.javaClass.simpleName) }\n        }\n    }","textDigest":"sha256:f37fdb3b2eae137d77c732fc910aa9ba29b8a969116ba122fc7a331aa11e7d94","url":"https://github.com/codeclew/clew-weather-demo/blob/c289b28be4819eddf29d59a7c12f178559ec5229/services/forecasts/src/main/kotlin/weather/Forecasts.kt#L62-L68"}},"processThread":null,"readerOptions":{"showInternalProcesses":false},"relatedViews":[],"renderer":"codeclew-documentation-html/1.16","requestedDocumentationLanguage":"en","revisions":{"forecasts":"c289b28be4819eddf29d59a7c12f178559ec5229"},"savedProcesses":[],"sectionState":{"contentRevisions":{"dashboard":"7e602ace02c04006fb7b2a2f5ecd88ba3c4005c6","forecasts":"c289b28be4819eddf29d59a7c12f178559ec5229"},"coverage":{"dashboard":{"boundaries":["CALL_TARGETS_UNRESOLVED","DIALECT_DECLARED_NOT_COMPILER_VALIDATED","FILE_ONLY:compose.yaml","FILE_ONLY:con