ecasts.kt/class:weather.Forecasts/publishPending/db0508abb6d728a6b0f2"},"sourceIds":["forecasts-3d7b217355f2e6a34064"],"status":"STATIC_SOURCE_OUTLINE","svgAvailable":true,"tree":"Entry: source:services/forecasts/src/main/kotlin/weather/Forecasts.kt/class:weather.Forecasts/publishPending/db0508abb6d728a6b0f2\n... (not established: FLOW_AUTHORITY_NOT_QUALIFIED; EVIDENCE_BOUNDARIES:FLOW_AUTHORITY_NOT_QUALIFIED)\n"},"processOutlineSources":{"forecasts-3d7b217355f2e6a34064":{"authority":"EXACT_SNAPSHOT_TEXT","endLine":139,"evidenceDigest":"sha256:c8204e0e1fc1a8921a3fb73ad0d0ef2b1ee66adcf7a27866824abbfc3caecfd9","file":"services/forecasts/src/main/kotlin/weather/Forecasts.kt","id":"forecasts-3d7b217355f2e6a34064","occurrence":{"blob":"7ed34fcd2d3540241148596c97a5d66fe5f2578a","endByte":9647,"snapshot":"sha256:34e943cd4cacb091768f46eaf8c99085c35c984784552ac335293714c4bd35b3","startByte":8813},"revision":"c289b28be4819eddf29d59a7c12f178559ec5229","service":"forecasts","startLine":127,"text":"@Scheduled(fixedDelayString = \"\\${PUBLISH_INTERVAL_MS:1000}\")\n    fun publishPending() {\n        try {\n            transaction.executeWithoutResult {\n                val rows = jdbc.queryForList(\"SELECT id,payload::text FROM forecast_outbox WHERE NOT published ORDER BY id LIMIT 1 FOR UPDATE SKIP LOCKED\")\n                if (rows.isEmpty()) return@executeWithoutResult\n                val row = rows.first()\n                val event = json.readTree(row[\"payload\"] as String)\n                kafka.send(\"weather.forecast-updated\", event[\"place\"][\"id\"].asText(), row[\"payload\"] as String).get(10, TimeUnit.SECONDS)\n                jdbc.update(\"UPDATE forecast_outbox SET published=true WHERE id=?\", row[\"id\"])\n            }\n        } catch (error: Exception) { System.err.println(\"PUBLISH_RETRY:\" + error.javaClass.simpleName) }\n    }","textDigest":"sha256:8a8703d6b15bac1a280cb22339d267641c3782a507215889aa9c92dbe3a5e0ab","url":"https://github.com/codeclew/clew-weat