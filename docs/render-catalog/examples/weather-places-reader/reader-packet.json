ask`1;","method":"OpenAsync","receiver":"connection","scope":"csproj:services/places/Places.csproj@net10.0"}]},{"code":"SOURCE_REFERENCE_CANDIDATE_AUTHORITY","count":1,"examples":[null]},{"code":"STRUCTURAL_DATAFLOW_NOT_AVAILABLE","count":1,"examples":[null]}],"methodSources":[{"authority":"EXACT_SNAPSHOT_TEXT","contextFor":"d971","contextReferences":["d971"],"evidence":["d971","s763"],"reference":"s763","sourceAliases":[{"authority":"EXACT_SNAPSHOT_TEXT","endByte":3388,"evidence":["s829"],"reference":"s829","startByte":2766},{"authority":"EXACT_SNAPSHOT_TEXT","endByte":977,"evidence":["s858"],"reference":"s858","startByte":707},{"authority":"EXACT_SNAPSHOT_TEXT","endByte":456,"evidence":["s891"],"reference":"s891","startByte":199},{"authority":"EXACT_SNAPSHOT_TEXT","endByte":2428,"evidence":["s935"],"reference":"s935","startByte":1671}],"text":"public class PlacesRepository\n{\n    private readonly string connectionString = Environment.GetEnvironmentVariable(\"DATABASE_URL\") ?? throw new InvalidOperationException(\"DATABASE_URL_REQUIRED\");\n    public static Place? City(string id) => id switch\n    {\n        \"oslo\" => new(\"oslo\", \"Oslo\", 59.93, 10.72),\n        \"helsinki\" => new(\"helsinki\", \"Helsinki\", 60.17, 24.94),\n        \"lisbon\" => new(\"lisbon\", \"Lisbon\", 38.72, -9.14),\n        _ => null\n    };\n    public async Task Ping(CancellationToken token)\n    {\n        await using var connection = await Open(token);\n        await using var command = new NpgsqlCommand(\"SELECT 1\", connection);\n        await command.ExecuteScalarAsync(token);\n    }\n    public async Task<NpgsqlConnection> Open(CancellationToken token)\n    {\n        var connection = new NpgsqlConnection(connectionString);\n        try { await connection.OpenAsync(token); return connection; }\n        catch { await connection.DisposeAsync(); throw; }\n    }\n    public async Task<IReadOnlyList<Place>> List(CancellationToken token)\n    {\n        await using var connection = await Open(token);\n        await using var command = new NpgsqlCommand(\"SELECT id,name,latitude,longitude FROM places ORDER BY name\", connection);\n        await using var reader = await command.ExecuteReaderAsync(token);\n        var result = new List<Place>();\n        while (await reader.ReadAsync(token)) result.Add(new(reader.GetString(0), reader.GetString(1), reader.GetDouble(2), reader.GetDouble(3)));\n        return result;\n    }\n    public async Task<Place?> Find(string id, CancellationToken token) => (await List(token)).FirstOrDefault(place => place.Id == id);\n    public async Task Save(Place city, CancellationToken token)\n    {\n        await using var connection = await Open(token);\n        await using var transaction = await connection.BeginTransactionAsync(token);\n        await using var command = new NpgsqlCommand(\"INSERT INTO places(id,name,latitude,longitude) VALUES($1,$2,$3,$4) ON CONFLICT DO NOTHING RETURNING id\", connection, transaction);\n        command.Parameters.AddWithValue(city.Id); command.Parameters.AddWithValue(city.Name); command.Parameters.AddWithValue(city.Latitude); command.Parameters.AddWithValue(city.Longitude);\n        if (await command.ExecuteScalarAsync(token) is not null) await InsertRequest(connection, transaction, city, token);\n        await transaction.CommitAsync(token);\n    }\n    public async Task Enqueue(Place city, CancellationToken token)\n    {\n        await using var connection = await Open(token);\n        await using var transaction = await connection.BeginTransactionAsync(token);\n        await InsertRequest(connection, transaction, city, token);\n        await transaction.CommitAsync(token);\n    }\n    private static async Task InsertRequest(NpgsqlConnection connection, NpgsqlTransaction transaction, Place city, CancellationToken token)\n    {\n        var id = Guid.NewGuid();\n        var json = JsonSerializer.Serialize(new { id, type = \"place.requested\", version = 1, place = city }, new JsonSerializerOptions(JsonSerializerDefaults.Web));\n        await using var command = new NpgsqlCommand(\"INSERT INTO request_outbox(id,payload) VALUES($1,$2::jsonb)\", connection, transaction);\n        command.Parameters.AddWithValue(id); command.Parameters.AddWithValue(json);\n        await command.ExecuteNonQueryAsync(token);\n    }\n}"},{"authority":"EXACT_SNAPSHOT_TEXT","contextFor":"d987","contextReferences":["d987"],"evidence":["d987","s921"],"reference":"s921","sourceAliases":[{"authority":"EXACT_SNAPSHOT_TEXT","endByte":568,"evidence":["s797"],"reference":"s797","startByte":230}],"text":"[ApiController]\npublic class PlacesController(PlacesRepository repository) : ControllerBase\n{\n    [HttpGet(\"/places\")]\n    public async Task<IReadOnlyList<Place>> List(CancellationToken token) => await repository.List(token);\n    [HttpPost(\"/places\")]\n    public async Task<IActionResult> Save([FromBody] SavePlace request, CancellationToken token)\n    {\n        var city = PlacesRepository.City(request.CityId);\n        if (city is null) return BadRequest(new { error = \"UNSUPPORTED_CITY\" });\n        await repository.Save(city, token);\n        return Ok(city);\n    }\n    [HttpPost(\"/places/{id}/refresh\")]\n    public async Task<IActionResult> Refresh(string id, CancellationToken token)\n    {\n        var city = await repository.Find(id, token);\n        if (city is null) return NotFound(new { error = \"PLACE_NOT_FOUND\" });\n        await repository.Enqueue(city, token);\n        return Accepted(new { placeId = id, status = \"QUEUED\" });\n    }\n    [HttpGet(\"/health\")]\n    public async Task<IActionResult> Health(CancellationToken token)\n    {\n        await repository.Ping(token);\n        return Ok(new { database = \"READY\" });\n    }\n    [HttpGet(\"/openapi.json\")]\n    public async Task<IActionResult> OpenApi(CancellationToken token) => Content(await System.IO.File.ReadAllTextAsync(\"/app/contracts/places.openapi.json\", token), \"application/json\");\n}"}],"methods":[{"body":{"endByte":567,"evidence":["s797"],"sourceReference":"s921","startByte":353},"declarationReference":"d975","evidence":["d975","s797"],"id":"m0","name":"Save","ownerIdentity":"class:Weather.Places.PlacesController","scope":"csproj:services/places/Places.csproj@net10.0","symbolIdentity":"method:class:Weather.Places.PlacesController#Save(LWeather/Places/SavePlace;LSystem/Threading/CancellationToken;)LSystem/Threading/Tasks/Task`1;"},{"body":{"endByte":454,"evidence":["s891"],"sourceReference":"s763","startByte":253},"declarationReference":"d986","evidence":["d986","s891"],"id":"m1","name":"City","ownerIdentity":"class:Weather.Places.PlacesRepository","scope":"csproj:services/places/Places.csproj@net10.0","symbolIdentity":"method:class:Weather.Places.PlacesRepository#City(LSystem/String;)LWeather/Places/Place;"},{"body":{"endByte":2427,"evidence":["s935"],"sourceReference":"s763","startByte":1735},"declarationReference":"d988","evidence":["d988","s935"],"id":"m2","name":"Save","ownerIdentity":"class:Weather.Places.PlacesRepository","scope":"csproj:services/places/Places.csproj@net10.0","symbolIdentity":"method:class:Weather.Places.PlacesRepository#Save(LWeather/Places/Place;LSystem/Threading/CancellationToken;)LSystem/Threading/Tasks/Task;"},{"body":{"endByte":3387,"evidence":["s829"],"sourceReference":"s763","startByte":2907},"declarationReference":"d977","evidence":["d977","s829"],"id":"m3","name":"InsertRequest","ownerIdentity":"class:Weather.Places.PlacesRepository","scope":"csproj:services/places/Places.csproj@net10.0","symbolIdentity":"method:class:Weather.Places.PlacesRepository#InsertRequest(LNpgsql/NpgsqlConnection;LNpgsql/NpgsqlTransaction;LWeather/Places/Place;LSystem/Threading/CancellationToken;)LSystem/Threading/Tasks/Task;"},{"body":{"endByte":976,"evidence":["s858"],"sourceReference":"s763","startByte":777},"declarationReference":"d981","evidence":["d981","s858"],"id":"m4","name":"Open","ownerIdentity":"class:Weather.Places.PlacesRepository","scope":"csproj:services/places/Places.csproj@net10.0","symbolIdentity":"method:class:Weather.Places.PlacesRepository#Open(LSystem/Threading/CancellationToken;)LSystem/Threading/Tasks/Task`1;"}],"notice":"This packet uses retained source and provider evidence to support an internal process draft. It is not a runtime trace, accepted narrative, review, or publication.","packetDigest":"sha256:56d7dc60aa18c537255c479a8edb6a1e78c5eb22b81ded0d76eeedd8d3979efe","profile":"process-graph-v1","question":"How does PlacesController.Save use the request and Place fields and select its response?","root":{"declarationReference":"d975","evidence":["d975"],"methodId":"m0","name":"Save","ownerIdentity":"class:Weather.Places.PlacesController","scope":"csproj:services/places/Places.csproj@net10.0","symbolIdentity":"method:class:Weather.Places.PlacesController#Save(LWeather/Places/SavePlace;LSystem/Threading/CancellationToken;)LSystem/Threading/Tasks/Task`1;"},"schema":"codeclew-documentation-reader-packet/1.0","sourceContexts":[],"title":"service:places · method:class:Weather.Places.PlacesController#Save(LWeather/Places/SavePlace;LSystem/Threading/CancellationToken;)LSystem/Threading/Tasks/Task`1;","types":[{"declarationKind":"CLASS","evidence":["d987"],"interfaces":[],"name":"PlacesController","ownerIdentity":"module:unnamed","reference":"d987","scope":"csproj:services/places/Places.csproj@net10.0","superclass":"class:Microsoft.AspNetCore.Mvc.ControllerBase","symbolIdentity":"class:Weather.Places.PlacesController"},{"declarationKind":"CLASS","evidence":["d971"],"interfaces":[],"name":"PlacesRepository","ownerIdentity":"module:unnamed","reference":"d971","scope":"csproj:services/places/Places.csproj@net10.0","superclass":null,"symbolIdentity":"class:Weather.Places.PlacesRepository"}]}